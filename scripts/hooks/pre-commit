#!/usr/bin/env bash
# pre-commit hook: block commits that introduce sensitive words into
# tracked / untracked files. Word lists live in:
#   - scripts/hooks/words.txt          (repo-shared, also scanned by CI)
#   - ~/.gitignore_local_words         (this machine only)
# Hooks read both files and concatenate at runtime.
#
# Scope: tracked files where working tree != HEAD (staged + unstaged)
#      + untracked, non-ignored files (would land in next `git add`).
# Skip : .venv*, node_modules, __pycache__, sessions/, others-sessions/
#
# Bypass for one-off:   git commit --no-verify
# Extend block-list:    edit scripts/hooks/words.txt (shared) and/or
#                       ~/.gitignore_local_words (local-only). Hooks are
#                       symlinked, so script edits take effect on next
#                       commit — no reinstall needed.

set -euo pipefail

# Locate repo root + word lists. Works whether this script runs from
# .git/hooks/ (installed) or scripts/hooks/ (raw checkout).
REPO_ROOT="$(git rev-parse --show-toplevel)"
WORDLIST="$REPO_ROOT/scripts/hooks/words.txt"
LOCAL_WORDLIST="$HOME/.gitignore_local_words"

if [ ! -f "$WORDLIST" ]; then
    echo "⚠️  No wordlist at $WORDLIST — pre-commit check skipped."
    exit 0
fi

# Make sure both wordlists end with a newline so `while read` doesn't drop
# the last entry (POSIX read returns 1 on EOF without trailing \n).
ensure_trailing_newline() {
    local f="$1"
    [ -f "$f" ] || return 0
    local last_byte
    last_byte=$(tail -c 1 "$f" | od -An -tx1 | tr -d ' ')
    if [ "$last_byte" != "0a" ]; then
        printf '\n' >> "$f"
    fi
}
ensure_trailing_newline "$WORDLIST"
ensure_trailing_newline "$LOCAL_WORDLIST"

# Combine repo wordlist with optional local-only wordlist.
# Local file is opt-in: missing file = no extra entries, no error.
COMBINED_WORDLIST=$(mktemp)
trap 'rm -f "$COMBINED_WORDLIST"' EXIT
cat "$WORDLIST" > "$COMBINED_WORDLIST"
if [ -f "$LOCAL_WORDLIST" ]; then
    cat "$LOCAL_WORDLIST" >> "$COMBINED_WORDLIST"
fi

# Candidate files: tracked diff + untracked (excluding .gitignore'd).
TRACKED_DIFF=$(git diff --name-only --diff-filter=AM HEAD 2>/dev/null || true)
UNTRACKED=$(git ls-files --others --exclude-standard 2>/dev/null || true)
FILES_TMP=$(printf "%s\n%s\n" "$TRACKED_DIFF" "$UNTRACKED" | grep -v '^$' || true)

if [ -z "$FILES_TMP" ]; then
    exit 0
fi

FAIL=0

while IFS= read -r word; do
    case "$word" in
        ""|"#"*) continue ;;
    esac

    while IFS= read -r file; do
        [ -z "$file" ] && continue
        [ -f "$file" ] || continue
        case "$file" in
            .venv/*|.venv-1/*|node_modules/*|__pycache__/*|sessions/*|others-sessions/*) continue ;;
            # The word lists contain the banned words by design.
            scripts/hooks/words.txt) continue ;;
            "$HOME/.gitignore_local_words") continue ;;
        esac

        if hits=$(grep -nF --color=never -- "$word" "$file" 2>/dev/null); then
            echo "❌ Sensitive word detected: '$word'"
            echo "   in $file"
            echo "$hits" | head -3 | sed 's/^/   /'
            echo
            FAIL=1
        fi
    done <<< "$FILES_TMP"
done < "$COMBINED_WORDLIST"

if [ "$FAIL" -eq 1 ]; then
    cat <<'TIP'

To bypass for a legitimate use case:
    git commit --no-verify

To extend the block-list:
    - everyone + CI:   edit scripts/hooks/words.txt
    - this machine:    edit ~/.gitignore_local_words
    Hooks are symlinked, so script edits take effect on next commit.

TIP
    exit 1
fi

exit 0
