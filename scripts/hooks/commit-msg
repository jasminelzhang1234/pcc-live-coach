#!/usr/bin/env bash
# commit-msg hook: block commits whose message contains sensitive words.
# Catches the case where the real name leaks into a commit message instead
# of a file — this is the leakiest case because `git log` and `git blame`
# surface it everywhere, and even git-filter-repo only rewrites what's
# already pushed.
#
# Word lists: scripts/hooks/words.txt (repo-shared + CI)
#           + ~/.gitignore_local_words (this machine only)
# Bypass for one-off:    git commit --no-verify
# Extend block-list:     edit scripts/hooks/words.txt (shared) and/or
#                        ~/.gitignore_local_words (local). Hooks are
#                        symlinked, so script edits take effect on next
#                        commit — no reinstall needed.

set -euo pipefail

MSG_FILE="$1"

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORDLIST="$REPO_ROOT/scripts/hooks/words.txt"
LOCAL_WORDLIST="$HOME/.gitignore_local_words"

if [ ! -f "$WORDLIST" ]; then
    echo "⚠️  No wordlist at $WORDLIST — commit-msg check skipped."
    exit 0
fi

# Make sure both wordlists end with a newline so `while read` doesn't drop
# the last entry (POSIX read returns 1 on EOF without trailing \n).
ensure_trailing_newline() {
    local f="$1"
    [ -f "$f" ] || return 0
    local last_byte
    last_byte=$(tail -c 1 "$f" | od -An -tx1 | tr -d ' ')
    if [ "$last_byte" != "0a" ]; then
        printf '\n' >> "$f"
    fi
}
ensure_trailing_newline "$WORDLIST"
ensure_trailing_newline "$LOCAL_WORDLIST"

# Combine repo + local wordlists. Local file is opt-in: missing = no extra.
COMBINED_WORDLIST=$(mktemp)
trap 'rm -f "$COMBINED_WORDLIST"' EXIT
cat "$WORDLIST" > "$COMBINED_WORDLIST"
if [ -f "$LOCAL_WORDLIST" ]; then
    cat "$LOCAL_WORDLIST" >> "$COMBINED_WORDLIST"
fi

FAIL=0

while IFS= read -r word; do
    case "$word" in
        ""|"#"*) continue ;;
    esac

    if grep -qF --color=never -- "$word" "$MSG_FILE" 2>/dev/null; then
        echo "❌ Sensitive word '$word' found in commit message:"
        grep -nF --color=never -- "$word" "$MSG_FILE" | head -3 | sed 's/^/   /'
        echo
        FAIL=1
    fi
done < "$COMBINED_WORDLIST"

if [ "$FAIL" -eq 1 ]; then
    cat <<'TIP'

To bypass for a legitimate use case:
    git commit --no-verify

To extend the block-list:
    - everyone + CI:   edit scripts/hooks/words.txt
    - this machine:    edit ~/.gitignore_local_words
    Hooks are symlinked, so script edits take effect on next commit.

TIP
    exit 1
fi

exit 0
