# PCC Live Coach — environment template.
#
# Copy to `.env` and fill in your own keys. `.env` is gitignored.
# NEVER commit `.env` — it contains API secrets.

# --- Server ---
PCC_LIVE_HOST=127.0.0.1
PCC_LIVE_PORT=8765
PCC_LIVE_LOG_LEVEL=info
# Set to 1 to allow binding 0.0.0.0 (LAN exposure). Default 0 = refuse.
PCC_LIVE_ALLOW_LAN=0

# --- LLM (MiniMax or any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1000
# M3 spends ~200 tokens on reasoning; needs headroom for actual reply
LLM_TEMPERATURE=0.6

# --- TTS (MiniMax T2A WebSocket) ---
TTS_WS_URL=wss://api.minimaxi.com/ws/v1/t2a_v2
TTS_API_KEY=
TTS_MODEL=speech-2.6-hd
TTS_VOICE=male-qn-jingying
TTS_SAMPLE_RATE=16000
TTS_TIMEOUT_S=30

# --- LLM retry + fallback (Gap 1) ---
# Default: no fallback (single-model setup uses LLM_MODEL only). To enable
# fallback, set LLM_FALLBACK_MODEL to a model name. llm_retry_max caps total
# attempts across both models (e.g. 2 = 1 primary + 1 fallback).
LLM_FALLBACK_MODEL=
LLM_RETRY_MAX=2

# --- Audio retention (Gap 2) ---
# raw/<id>.wav files older than this are auto-deleted on server start.
# 0 = disabled (files live forever). See PRIVACY.md §6.5.
AUDIO_RETENTION_DAYS=30

# --- ASR (阿里云实时语音识别, 2026-09-06 起替代 FunASR) ---
# Setup: phase_b/_reports/aliyun-asr-setup-2026-09-06.md
# 项目类型必须选 "实时语音识别" (不是 "一句话识别")
ALIYUN_ASR_APPKEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=30
AUDIO_CHANNELS=1

# --- Rhythm thresholds ---
SILENCE_THRESHOLD_MS=2000
CPM_SLOW=120
CPM_IDEAL_LOW=150
CPM_IDEAL_HIGH=200
CPM_FAST=280
BARGE_IN_DEBOUNCE_MS=500

# --- Paths ---
PERSONAS_DIR=personas
SESSIONS_DIR=practice-logs/sessions
TRACKER_CSV=progress/tracker-sessions.csv
# Trending chart output. Empty = default per-day file under progress/.
# Absolute path = used as-is. Relative = resolved against repo root.
# Literal "{date}" is substituted with today's YYYY-MM-DD.
# Example: reports/trending-{date}.html
# TRENDING_CHART_PATH=
