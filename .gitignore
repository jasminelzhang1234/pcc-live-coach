# ===== Coach session artifacts — never commit =====
sessions/

# 他人陪练 / 评估归档(对话原文 + pcc-assessor 报告,不入版本控制)
others-sessions/

# 校准案例(真实对话记录 + 督导点评,仅本地使用)
knowledge/校准案例/

# 个人陪练实践日志(本地工作日志,不入版本控制)
practice-logs/

# ===== 训练记录 + 校准工作文档(内部沉淀,真人姓名/路径全在这里) =====
# 整个 progress/ 屏蔽:含 tracker.csv(AI 模拟 + 真人 session)、
# 校准三方对照(真人督导师真名)、tracker-sessions.csv(真人场数据)、
# trending-chart.html、prompts/、v3-KB-candidates/、snapshots/、claude-judgment-*.json
progress/

# 设计/实施计划 + 个人笔记(开发轨迹,含完整 Mac 路径)
plans/
notes/

# 设计 spec / dashboard mockup / 历史 commit 痕迹(开发轨迹文档,入版本控制意义不大)
docs/
# 例外:roadmap.md 是永久决策归档,需入版本控制
!docs/roadmap.md

# 真人案例评估报告(对应 knowledge/校准案例/ 已屏蔽,但产物散落)
calibration-reports/

# pcc-assessor 反偏松规则的真人案例锚点(2026-09-11 加)
# 含真人客户原话 + 真人督导师编号 + 具体行号,作为 pcc-assessor 内部加载项
# 公开仓库只保留规则描述,clone-only 环境降级到规则-only 判定
knowledge/pcc-assessor-cases.md

# 参考材料索引(含内部作者署名)
Reference/

# Phase A 设计/实施计划 HTML(含本地完整路径,可能暴露作者信息)
PCC-陪练与评估-Agent-设计方案.html
PCC-陪练与评估-Agent-实施计划.html

# ===== Phase B — never commit secrets =====
.env
.env.local
.venv*/

# Local Claude Code MCP config (contains absolute paths)
.mcp.json

# Runtime logs
logs/

# Claude Code runtime token tracking(每次跑 python 自动 append,本地调试用,不入版本控制)
observability/token-usage.csv
# observability 报告 HTML/MD(只 csv 屏蔽不够;dashboard/report 含 token 用量 + 元数据)
observability/*.html
observability/*.md

# 测试子目录的 __pycache__(根级 __pycache__/ 已被顶层规则覆盖,子目录需显式列出)
tests/**/__pycache__/
